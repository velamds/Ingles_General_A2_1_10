 6, "time": "45000", "text": "<span class=\"strong\">Sally</span>: How can I reserve a place?<br>\n<span class=\"strong\">Concierge</span>: Let me inquire for you Miss ...<br>\n<span class=\"strong\">Sally</span>: Davis. Thank you. <br>"}, {"image": "engenn4le10ob07re2img01.jpg", "id": 7, "time": "54000", "text": "<span class=\"strong\">Concierge</span>: Tonight is available.<br>\n<span class=\"strong\">Sally</span>: That's perfect!"}], "coverimg": "engenn4le10ob07re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 2}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "I can ask for and provide information.", "type": "Learning Outcomes"}, {"content": "I can ask and give directions.", "type": "Learning Outcomes"}, {"content": "I can tell someone where something is located.", "type": "Learning Outcomes"}, {"content": "Do you ever use a bicycle?", "type": "Free Header Item"}, {"content": "Do people in your city ride them to work? Why or why not?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct"}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Ah, Amsterdam! Watch out for the bicycles!", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"id": 1, "stimuli_ids": [2], "template_override": 1, "_data": [{"contents": [{"content": "Sally can sit in <span class=\"tool-tip\" id=\"tip_1_0\">the cabin</span> and enjoy the view from 