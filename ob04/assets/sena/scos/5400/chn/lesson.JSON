{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally in Continental Europe"}, {"type": "unit_name", "content": "Where Should I Go First?"}, {"type": "position", "content": 4}, {"type": "origin", "content": "scholar > Between the Market Stalls > Holland Flower Market"}, {"type": "lesson", "content": 10}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations"}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Modals to Express Suggestions"}, {"type": "describer", "content": "You use <span class=\"italic\">should</span>, <span class=\"italic\">could</span>, <span class=\"italic\">might</span> and <span class=\"italic\">shall</span> to express suggestions.<br> <br>You can use <span class=\"italic\">might</span> with <span class=\"italic\"> want</span> or <span class=\"italic\">like</span> to be polite.<br>"}, {"type": "example", "content": "<span class=\"strong\">Shouldn't</span> we <span class=\"strong\">take</span> a walk along the canal? "}, {"type": "example", "content": "You <span class=\"strong\">could talk</span> to Sally on video chat and <span class=\"strong\">ask</span> her."}, {"type": "example", "content": "You <span class=\"strong\">might consider</span> taking up yoga."}, {"type": "example", "content": "<span class=\"strong\">Shall </span> we <span class=\"strong\">throw</span> a party once I get back from Amsterdam?"}, {"type": "example", "content": "I thought you <span class=\"strong\">might want/like to look</span> at this map."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "foggy "}, {"type": "definition", "content": "cloudy on the ground and on buildings "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It is a cold, foggy day."}, {"type": "audio", "content": "engenn4le10ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear in a conversation."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gang"}, {"type": "definition", "content": "a group of friends who do things together "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The gang is all here."}, {"type": "audio", "content": "engenn4le10ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "impression "}, {"type": "definition", "content": "influence how someone feels "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It's our first date. I hope I make a good impression."}, {"type": "audio", "content": "engenn4le10ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "pancake"}, {"type": "definition", "content": "a thin, flat, cake fried on both sides "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I lo